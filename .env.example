# =============================================================================
#  Copy to .env and fill in. .env is git-ignored; this file is not.
#
#  Spring loads it via `spring.config.import: optional:file:.env[.properties]`,
#  so it is read as a .properties file: KEY=value, no `export`, no quotes
#  unless the quotes are part of the value.
#
#  Every key here is OPTIONAL in dev - application.yml has a working default
#  for each one. In prod most of them are REQUIRED (marked below); the app
#  fails to start rather than fall back to a development value.
# =============================================================================

# --- Core -------------------------------------------------------------------
APP_NAME=springapp
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database ------------------------------------------------- prod: REQUIRED
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_test_spring
# When running through docker-compose, DB_USERNAME must NOT be `root`: the
# MySQL image refuses MYSQL_USER=root. Use a dedicated application user.
DB_USERNAME=root
DB_PASSWORD=
# Only used by docker-compose to initialise the MySQL container; the app never
# connects with it.
MYSQL_ROOT_PASSWORD=rootpassword
DB_USE_SSL=false
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# --- Schema -----------------------------------------------------------------
# Flyway owns the schema and Hibernate validates against it. To let Hibernate
# generate tables for throw-away local work instead:
#   JPA_DDL_AUTO=update  and  FLYWAY_ENABLED=false
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# --- Redis ---------------------------------------------------- prod: REQUIRED
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
# Refuse to start when Redis is unreachable. Leave true outside tests.
REDIS_FAIL_FAST=true

# --- Cache TTLs (Spring duration syntax: 30m, 90s, 2h) ----------------------
CACHE_DEFAULT_TTL=30m
CACHE_USERS_TTL=10m
CACHE_TOKENS_TTL=5m

# --- JWT ------------------------------------------------------ prod: REQUIRED
# Must be Base64-encoded and at least 256-bit for HS256. Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS / frontend ------------------------------------------ prod: REQUIRED
FRONTEND_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Reverse proxy ----------------------------------------------------------
# Comma-separated proxy IPs whose X-Forwarded-For / X-Real-IP may be trusted
# for rate limiting. Leave EMPTY unless the app really sits behind a proxy you
# control - otherwise any client can spoof its IP and bypass the limits.
TRUSTED_PROXIES=

# --- Mail ----------------------------------------------------- prod: REQUIRED
MAIL_APP_NAME=SPRING_APP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
# Implicit SMTPS. Leave false when using STARTTLS on port 587.
MAIL_SSL_ENABLED=false

# --- OAuth2 (Google) ------------------------------------------ prod: REQUIRED
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/code/google
# Restrict sign-in to these e-mail domains, comma-separated. Empty = any domain.
OAUTH2_ALLOWED_EMAIL_DOMAINS=

# --- File upload ------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# --- Async thread pools -----------------------------------------------------
ASYNC_TASK_CORE_SIZE=5
ASYNC_TASK_MAX_SIZE=10
ASYNC_TASK_QUEUE_CAPACITY=25
ASYNC_EMAIL_CORE_SIZE=2
ASYNC_EMAIL_MAX_SIZE=5
ASYNC_EMAIL_QUEUE_CAPACITY=10

# --- Docs & logging ---------------------------------------------------------
# Keep SWAGGER_ENABLED=false in production.
SWAGGER_ENABLED=true
LOG_LEVEL=DEBUG
# Directory the log files are written to (logback-spring.xml builds the names).
LOG_PATH=logs

# --- TLS at the app (prod only; usually terminated at the load balancer) -----
SSL_ENABLED=false
SSL_KEYSTORE=
SSL_KEYSTORE_PASSWORD=
SSL_KEYSTORE_TYPE=PKCS12
